# ============================================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env-empty .env
# ============================================================

# --- Bot ---
ANIME_BOT_TOKEN=
# ID администраторов через запятую, напр. 123456,789012
ANIME_BOT_ADMIN_LIST=
# Интервал задачи скраппинга (минуты)
ANIME_BOT_SCRAPPING_TASK_INTERVAL=
# URL страницы для скраппинга
ANIME_BOT_SCRAPPING_TASK_URL=
# Прокси для получения HTML (необязательно). Если задан, запрос идёт на этот URL,
# а целевая страница (из ANIME_BOT_SCRAPPING_TASK_URL + /year/season и т.д.)
# передаётся в query-параметре _target, например:
# ANIME_BOT_SCRAPPING_TASK_PROXY_URL=https://proxy.example.com/fetch
# -> GET https://proxy.example.com/fetch?_target=https%3A%2F%2Fanimego.me%2Fanime%2Fseason%2F2026%2Ffall
ANIME_BOT_SCRAPPING_TASK_PROXY_URL=
# Интервал задачи автодобавления сезонов с animego.me (минуты, по умолчанию 1440 — раз в сутки)
ANIME_BOT_SEASON_SCRAPPING_TASK_INTERVAL=1440
# Режим отладки (оставьте пустым или задайте 1/true)
ANIME_DEBUG=

# Логирование в формате JSON (1 — JSON для production/journald; пусто — читаемый вывод в терминале, JSON в неинтерактивной среде)
ANIME_LOG_JSON=

# --- Webhook server ---
ANIME_SERVER_HOST=
ANIME_SERVER_PORT=8081

# --- PostgreSQL (используется и контейнером db в docker-compose) ---
POSTGRES_USER=animealarm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=animealarm

# --- DB connection for the bot ---
# В docker-compose хост БД = имя сервиса `db` (см. docker-compose.yml),
# при локальном запуске — localhost:5432
ANIME_DB_DSN=postgresql+psycopg://animealarm:change-me-strong-password@db:5432/animealarm
# Схема БД (по умолчанию animealarm)
ANIME_DB_SCHEMA=animealarm
